# /etc/hlkit.env
# Read by install.sh, the hlnode service and every script in ops/.
# Change a value, then run: sudo systemctl restart hlnode (only for NODE_FLAGS)

# User that runs the node, and its home. The node keeps visor.json,
# override_gossip_config.json and the data folder (hl/data) in this home.
HL_USER=hl
HL_HOME=/home/hl

# Flags passed to run-non-validator. See the official node README for the
# full list. --serve-info starts the local info server on port 3001.
NODE_FLAGS="--serve-info --write-fills --write-misc-events --disable-output-file-buffering"

# Where install.sh copies the ops scripts, and where they keep state.
KIT_DIR=/opt/hlkit
STATE_DIR=/var/lib/hlkit

# Local info server, used by the watchdog, health.sh and the MCP server.
INFO_URL=http://localhost:3001/info

# Cleanup: hourly output files older than this many hours are deleted.
CLEANUP_RETENTION_HOURS=24

# Watchdog: restart when the node is more than this many seconds behind
# the chain, at most once per cooldown, at most FAILURE_BUDGET times in a
# row before it stops and alerts instead.
WATCHDOG_LAG_THRESHOLD=600
WATCHDOG_COOLDOWN_SECONDS=900
WATCHDOG_FAILURE_BUDGET=3
# No restarts during the first N seconds after the service starts. The
# first state download can take 10 to 30 minutes.
WATCHDOG_STARTUP_GRACE=1800

# Peers: how many root peers to keep, and whether to sort them by TCP
# connect time from this host (1) or keep the published order (0).
PEERS_KEEP=16
PEERS_SORT_BY_LATENCY=1

# Optional: a Slack-compatible webhook for watchdog alerts.
ALERT_WEBHOOK_URL=
